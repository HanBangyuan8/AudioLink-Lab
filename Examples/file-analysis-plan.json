{
  "schemaVersion": "1.0",
  "metadata": { "name": "file-analysis-example", "purpose": "offline CI fixture" },
  "measurementMode": "file-analysis",
  "repetitions": 1,
  "exportFormats": ["json"],
  "failurePolicy": "continueOnError",
  "privacy": { "storeAudio": "false" },
  "timeoutSeconds": 300,
  "tasks": [
    {
      "operation": "file-analysis",
      "referenceFile": "reference.wav",
      "recordingFile": "recording.wav",
      "configuration": { "channel": 0, "method": "automatic", "normalize": true }
    }
  ]
}
